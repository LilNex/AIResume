# Copier ce fichier en .env puis remplir les valeurs.
# Modèle LiteLLM, ex. : groq/llama-3.3-70b-versatile ou gemini/gemini-2.0-flash
LLM_MODEL=groq/llama-3.3-70b-versatile

# Renseigner la clé correspondant au fournisseur choisi
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Modèle d'embeddings utilisé par le mode RAG
EMBEDDING_MODEL=gemini/text-embedding-004
